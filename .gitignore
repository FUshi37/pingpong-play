# Output files
outputs/
# High-rate experiment payloads must not be indexed while control runs.
# Keep analysis scripts/reports available; these generated recordings stay on disk.
# Exclude whole recording trees, including live/readonly archives, so Git
# can skip their contents regardless of the payload format.
analysis_results/**/*recordings/
analysis_results/**/probe_recording_*/
analysis_results/**/raw_camera/
analysis_results/**/*.jsonl
analysis_results/**/*.npz
analysis_results/**/*.jpg
analysis_results/**/*.jpeg
*.csv
*.json
*.png
*.mp4
*.avi

