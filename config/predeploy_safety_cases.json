{
  "schema_version": 1,
  "description": "simcode9 每次部署前检查目录；未实施/未覆盖项不得冒充通过。门槛为本流程验收门槛，不能证明所有实物危险均被覆盖。",
  "thresholds": {
    "minimum_feedback_samples": 40,
    "minimum_feedback_hz": 190,
    "maximum_feedback_gap_s": 0.02,
    "minimum_command_update_hz": 190,
    "maximum_command_update_gap_s": 0.02,
    "baseline_duration_s": 2,
    "minimum_motion_span_deg": 0.5,
    "minimum_stop_entry_speed_deg_s": 5,
    "joint_velocity_limit_deg_s": [
      210,
      210,
      240,
      240,
      300,
      300,
      300
    ],
    "joint_acceleration_limit_deg_s2": [
      1300,
      1300,
      1800,
      3000,
      3000,
      3000,
      3000
    ],
    "maximum_stop_displacement_m": 0.02,
    "maximum_stop_latency_s": 0.7,
    "stop_observation_s": 1.5,
    "settled_speed_deg_s": 2,
    "settled_quiet_s": 0.3,
    "monitor_feedback_timeout_s": 0.02,
    "reset_joint_corridor_margin_deg": 1.0,
    "reset_maximum_measured_speed_deg_s": 20.0,
    "reset_maximum_measured_acceleration_deg_s2": 80.0,
    "reset_final_joint_error_deg": 0.5
  },
  "cases": [
    {
      "id": "asset_contract",
      "stage": "offline",
      "title": "模型、XML、训练观测和发布合约一致",
      "critical": true,
      "tests": [
        "test_authenticated_actor_and_manifest*",
        "test_profile_identity_and_xml_fail_before_loading*"
      ]
    },
    {
      "id": "native_reset",
      "stage": "offline",
      "title": "原生复位点、冻结参考及禁止旧复位种子",
      "critical": true,
      "tests": [
        "test_frozen_fk_and_warm_posture_match_original_cpu_xml_pipeline*",
        "test_fplc_reset_cannot_select_the_old_warm_seed*"
      ]
    },
    {
      "id": "projection_equivalence",
      "stage": "offline",
      "title": "笛卡尔映射和24次投影保持训练算术",
      "critical": true,
      "tests": [
        "test_original_24_sweep_weighted_projection_pairing*",
        "test_compiled_single_lane_projection_matches_original_arithmetic*",
        "test_non_linear_backstop_and_reference_integration*"
      ]
    },
    {
      "id": "no_limiter",
      "stage": "offline",
      "title": "正常/复位/停发/硬停止均不得访问 safety_limiter",
      "critical": true,
      "tests": [
        "test_safe_publish_and_supervised_reset_never_enter_limiter*",
        "test_publish_boundary_latches_and_never_enters_limiter*"
      ]
    },
    {
      "id": "physical_envelope",
      "stage": "offline",
      "title": "独立实物 XYZ 与 RP±4° 逐边界拦截",
      "critical": true,
      "tests": [
        "test_real_attitude_envelope_at_publish_boundary*",
        "test_real_z_envelope_is_independent_at_publish_boundary*",
        "test_workspace_malformed_and_empty_intersections_fail_closed*"
      ]
    },
    {
      "id": "feedback_faults",
      "stage": "offline",
      "title": "过期/缺失/非法 q、dq、年龄与关节形状",
      "critical": true,
      "tests": [
        "test_predeploy_bad_feedback_never_arms_or_publishes*",
        "test_predeploy_invalid_atomic_age_never_reaches_actor*",
        "test_stale_atomic_actor_feedback_is_rejected_even_if_later_feedback_is_fresh*",
        "test_20hz_feedback_arm_failure_preserves_trigger_details*"
      ]
    },
    {
      "id": "bad_actor",
      "stage": "offline",
      "title": "策略 NaN/Inf/错误长度/推理异常撤销并丢弃历史",
      "critical": true,
      "tests": [
        "test_predeploy_bad_actor_output_disarms*",
        "test_predeploy_inference_exception_disarms*",
        "test_predeploy_invalid_web_ball_is_invalid_not_a_valid_default*",
        "test_invalid_inputs_and_direct_observed_flag*"
      ]
    },
    {
      "id": "backend_exception",
      "stage": "offline",
      "title": "控制循环意外异常不得继续旧指令流",
      "critical": true,
      "tests": [
        "test_predeploy_backend_exception_disarms*"
      ]
    },
    {
      "id": "ball_done_latch",
      "stage": "offline",
      "title": "低球 done、恢复输入与旧 Send 请求不自动恢复",
      "critical": true,
      "tests": [
        "test_fplc_ball_done_disarms_and_latches_until_reset*",
